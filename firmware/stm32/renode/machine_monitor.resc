# ============================================================================
#  Renode: runs the real STM32 firmware (.elf built by STM32CubeIDE)
#  Launch:  renode renode/machine_monitor.resc
#  Then, in another terminal:  python gateway/uart_gateway.py --tcp localhost:3456
# ============================================================================
using sysbus
$name?="machine-monitor"
mach create $name

# STM32F4 Discovery board (STM32F407) — create your CubeIDE project for this board
machine LoadPlatformDescription @platforms/boards/stm32f4_discovery-kit.repl

# Binary path (can be overridden: renode -e '$bin=@/path/to/firmware.elf')
$bin?=@Debug/machine_monitor.elf

# USART2 = debug console → Renode analyzer window
showAnalyzer sysbus.usart2

# USART1 = "ESP32" link → exposed on TCP port 3456 for the gateway
emulation CreateServerSocketTerminal 3456 "esp32_link" false
connector Connect sysbus.usart1 esp32_link

macro reset
"""
    sysbus LoadELF $bin
"""
runMacro $reset
start
