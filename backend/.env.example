PORT=4000
# Public broker (demo, no security):
MQTT_URL=mqtt://broker.hivemq.com:1883
# PRIVATE broker (TLS + password), EMQX Cloud Serverless or HiveMQ Cloud: replace the line above with
# MQTT_URL=mqtts://xxxxxxxx.ala.eu-central-1.emqxsl.com:8883
MQTT_USERNAME=
MQTT_PASSWORD=
# ⚠️ Must match TOPIC_PREFIX in sketch.ino / simulator
TOPIC_PREFIX=pfe-monitor-7f3a
# Local : mongodb://127.0.0.1:27017/machine_monitor (127.0.0.1, not localhost, on Windows)  |  Atlas : mongodb+srv://...
MONGO_URL=mongodb://127.0.0.1:27017/machine_monitor
OFFLINE_SEC=10

# Telegram notifications (optional): see tools/telegram-setup.js
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
