PORT=4000
# Broker public (démo, sans sécurité) :
MQTT_URL=mqtt://broker.hivemq.com:1883
# Broker PRIVÉ HiveMQ Cloud (TLS + mot de passe) : remplace la ligne ci-dessus par
# MQTT_URL=mqtts://xxxxxxxxxxxx.s1.eu.hivemq.cloud:8883
MQTT_USERNAME=
MQTT_PASSWORD=
# ⚠️ Doit être identique à TOPIC_PREFIX dans sketch.ino / simulator
TOPIC_PREFIX=pfe-monitor-7f3a
# Local : mongodb://127.0.0.1:27017/machine_monitor (127.0.0.1 et non localhost sous Windows)  |  Atlas : mongodb+srv://...
MONGO_URL=mongodb://127.0.0.1:27017/machine_monitor
OFFLINE_SEC=10

# Notifications Telegram (optionnel) : voir tools/telegram-setup.js
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
